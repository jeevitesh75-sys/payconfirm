# ---- REQUIRED (the server refuses to start if these are missing or still "change-me") ----
UPI_VPA=yourname@bank
API_KEY=change-me-long-random-string
WATCHER_SECRET=change-me-another-long-random-string

# ---- Optional ----
MERCHANT_NAME=My Store
PORT=8080
# 127.0.0.1 = only this machine (safest, use with a tunnel or Caddy). 0.0.0.0 = reachable on your network.
HOST=127.0.0.1
# The public address customers will see, no trailing slash
PUBLIC_URL=http://localhost:8080
# Minutes a customer has to pay after the QR is created
HOLD_MINUTES=15
# Last 4 digits of your bank account. SMS that do not contain them are ignored.
ACCOUNT_LAST4=
# Your website's endpoint that should be told when a payment is confirmed (signed with CALLBACK_SECRET)
CALLBACK_URL=
CALLBACK_SECRET=
